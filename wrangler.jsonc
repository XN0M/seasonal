{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seasonal-affiliate-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "rules": [{"type":"Text","globs":["**/admin/*.txt"],"fallthrough":false}],
  "preview_urls": false,
  "d1_databases": [{"binding":"DB","database_name":"seasonal-admin-local","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "triggers": {"crons":["41 2 * * *"]},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
