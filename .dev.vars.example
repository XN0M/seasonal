# Copy to .dev.vars only when configuring an approved environment.
# No test bypass exists in the deployed Worker. Never commit secrets.
ADMIN_AUTH_MODE=password
# First account creation is permitted ONLY on HTTP 127.0.0.1; never enable remotely.
ADMIN_LOCAL_SETUP=false
ADMIN_ORIGIN=
# Optional comma-separated additional OWN hostname aliases to reject as redirect targets.
REDIRECT_SELF_HOSTS=
ACCESS_TEAM=
ACCESS_AUD=
OWNER_EMAIL=
CSRF_SECRET=
BUILD_ACCESS_AUD=
BUILD_SERVICE_SUB=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_REF=
PUBLISH_ENVIRONMENT=
