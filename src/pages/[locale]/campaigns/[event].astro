---
import SiteLayout from '@/layouts/SiteLayout.astro'
import BrandPicks from '@/components/commerce/BrandPicks.astro'
import {events} from '@/data/catalog'
import {localeCodes,type Locale,type SeasonalEvent} from '@/lib/types'
import {ui,localPath} from '@/lib/i18n'
export const getStaticPaths=()=>localeCodes.flatMap(locale=>events.filter(event=>event.theme!=='halloween').map(event=>({params:{locale,event:event.slug[locale]},props:{locale,event}})))
const {locale,event}=Astro.props as {locale:Locale;event:SeasonalEvent}
const t=ui[locale]
---
<SiteLayout title={`${event.name[locale]} | Seasonal Edit`} description={event.description[locale]} {locale} {event} pathname={`campaigns/${event.slug[locale]}/`}><section class="container section-compact"><p class="section-label">{event.eyebrow[locale]}</p><h1 class="editorial-heading">{event.headline[locale]}</h1><p class="section-intro">{event.description[locale]}</p><a class="text-link" href={`${localPath(locale,'gift-finder/')}?event=${event.id}`}>{t.findGift} →</a><h2 class="sr-only">{t.brands}</h2><BrandPicks {locale} eventId={event.id} placement="campaign-brand"/></section></SiteLayout>
