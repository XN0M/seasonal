---
import SiteLayout from '@/layouts/SiteLayout.astro'
import ProductCard from '@/components/commerce/ProductCard.astro'
import {events,products} from '@/data/catalog'
import {commerceCard} from '@/data/shop'
import {localeCodes,type Locale,type SeasonalEvent} from '@/lib/types'
import {localeConfig,ui,localPath} from '@/lib/i18n'
export const getStaticPaths=()=>localeCodes.flatMap(locale=>events.filter(event=>event.theme!=='halloween').map(event=>({params:{locale,event:event.slug[locale]},props:{locale,event}})))
const {locale,event}=Astro.props as {locale:Locale;event:SeasonalEvent}
const market=localeConfig[locale].market,t=ui[locale]
const selected=products.filter(product=>product.events.includes(event.id))
---
<SiteLayout title={`${event.name[locale]} | Seasonal Edit`} description={event.description[locale]} {locale} {event} pathname={`campaigns/${event.slug[locale]}/`}><section class="container section-compact"><p class="section-label">{event.eyebrow[locale]}</p><h1 class="editorial-heading">{event.headline[locale]}</h1><p class="section-intro">{event.description[locale]}</p><a class="text-link" href={`${localPath(locale,'gift-finder/')}?event=${event.id}`}>{t.findGift} →</a><p class="muted">{t.checked} · {t.pending}</p><div class="product-grid">{selected.map(product=><ProductCard {...commerceCard(product,market)} {locale} {market} eventId={event.id} pendingLabel={t.pending} bestForLabel={t.bestFor} previewLabel={t.preview}/>)}</div></section></SiteLayout>
