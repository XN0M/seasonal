---
import {getCollection,render} from 'astro:content'
import SiteLayout from '@/layouts/SiteLayout.astro'
import {activeEvent} from '@/data/catalog'
import type {Locale} from '@/lib/types'
import {brandRegistry} from '@/data/brands'
import {brandCards} from '@/lib/brands'
import {brandCopy} from '@/lib/brand-copy'
import {localeConfig,formatDate,ui} from '@/lib/i18n'
import BrandCard from '@/components/commerce/BrandCard.astro'
import FeaturedProductCard from '@/components/commerce/FeaturedProductCard.astro'
import type {CollectionEntry} from 'astro:content'
export async function getStaticPaths(){const guides=await getCollection('guides');return guides.map(guide=>({params:{locale:guide.data.locale,slug:guide.data.slug},props:{locale:guide.data.locale,guide}}))}
const {locale,guide}=Astro.props as {locale:Locale;guide:CollectionEntry<'guides'>}
const {Content}=await render(guide)
const market=localeConfig[locale].market,t=ui[locale],bt=brandCopy[locale]
const related=brandCards(brandRegistry,market,activeEvent.id,locale).filter(card=>guide.data.relatedBrandIds.includes(card.profile.id))
const minutes=Math.max(1,Math.ceil((guide.body||'').split(/\s+/u).length/200))
const structuredData={'@context':'https://schema.org','@type':'Article',headline:guide.data.title,description:guide.data.excerpt,dateModified:guide.data.updatedAt.toISOString(),inLanguage:localeConfig[locale].languageTag,author:{'@type':'Organization',name:'Seasonal Edit'},creativeWorkStatus:'Review pending'}
---
<SiteLayout title={`${guide.data.title} | Seasonal Edit`} description={guide.data.excerpt} {locale} {structuredData} event={activeEvent} pathname={`guides/${guide.data.slug}/`}>
  <section class="guide-reading"><article class="container section article"><p class="section-label">{guide.data.category}</p><h1>{guide.data.title}</h1><p class="intro">{guide.data.excerpt}</p><p>{t.updated}: <time datetime={guide.data.updatedAt.toISOString()}>{formatDate(guide.data.updatedAt.toISOString(),locale)}</time> · {minutes} {t.reading}</p><p class="review">{t.reviewPending}</p><div class="article-body" lang={localeConfig[locale].languageTag}><Content/></div><section class="guide-sources"><h2>{t.sources}</h2><ul>{guide.data.sources.map(url=><li><a class="text-link" href={url} rel="nofollow noreferrer">{new URL(url).hostname.replace(/^www\./,'')}<span aria-hidden="true"> ↗</span></a></li>)}</ul></section></article></section>
  <section class="container section-compact" aria-labelledby="related-guide-brands"><h2 class="editorial-heading" id="related-guide-brands">{t.relatedBrands}</h2><p class="grid-disclosure">{bt.disclosure}</p><p class="section-intro">{bt.destination}</p><div class="brand-grid">{related.map(card=><BrandCard {card} {locale} {market} eventId={activeEvent.id} placement={`guide-${guide.data.slug}`}/>)}</div>{guide.data.slug==='age-appropriate-gifts' && related[0] && <div class="brand-grid guide-product-examples">{related[0].products.map(product=><FeaturedProductCard {product} card={related[0]!} {locale} {market} eventId={activeEvent.id}/>)}</div>}</section>
</SiteLayout>
<style>.guide-product-examples{margin-top:24px}.guide-sources h2{font-family:var(--display);font-size:2rem;font-weight:500}.guide-sources ul{padding-left:20px}</style>
<style>.article{max-width:min(70ch,calc(100% - 32px))}.article h1{font-family:var(--display);font-weight:500;font-size:clamp(2.8rem,6vw,5.5rem);line-height:.97;letter-spacing:-.04em}.intro{font-size:1.15rem;color:var(--muted-text)}.review{border-left:3px solid var(--champagne);padding:15px;background:var(--paper-raised);font-size:.8rem}.article-body :global(h2){font-family:var(--display);font-weight:500;font-size:2rem;line-height:1.1;margin-top:40px}.article-body :global(p){line-height:1.8;color:var(--muted-text)}</style>
