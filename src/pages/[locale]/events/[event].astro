---
import SiteLayout from '@/layouts/SiteLayout.astro'
import FAQ from '@/components/editorial/FAQ.astro'
import EventHero from '@/components/editorial/EventHero.astro'
import SeasonalDecoration from '@/components/editorial/SeasonalDecoration.astro'
import BrandPicks from '@/components/commerce/BrandPicks.astro'
import {brandCopy} from '@/lib/brand-copy'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import EditorialHeading from '@/components/ui/EditorialHeading.astro'
import { events } from '@/data/catalog'
import { localeConfig, ui, localPath } from '@/lib/i18n'
import { localeCodes, type Locale } from '@/lib/types'
import { eventPhaseLabels, resolveEventPhase } from '@/lib/events'
import { halloweenCopy } from '@/lib/seasonal/copy'
export const getStaticPaths = () => localeCodes.flatMap(locale => events.map(event => ({ params: { locale, event: event.slug[locale] }, props: { locale, event } })))
const { locale, event } = Astro.props as { locale: Locale; event: (typeof events)[number] }
const t = ui[locale]
const bt=brandCopy[locale]
const market = localeConfig[locale].market
const phase = resolveEventPhase(event, market)
const phaseLabels = eventPhaseLabels(event)
const halloween = event.theme === 'halloween'
const hw = halloweenCopy[locale]
---
<SiteLayout title={`${event.name[locale]} | Seasonal Edit`} description={event.description[locale]} {locale} {event} preloadHero pathname={`events/${event.slug[locale]}/`}>
  <EventHero {event} {locale} primary={t.findGift} secondary={t.gifts} secondaryHref="#event-picks" />
  <section class="event-detail section-compact">
    <SeasonalDecoration theme={event.theme} placement="event-info" staticOnly={halloween}/>
    <div class="container event-detail__grid">
      <div><SectionLabel text={t.phases}/><EditorialHeading>{halloween ? hw.now : t.now}: {phaseLabels[phase][locale]}</EditorialHeading></div>
      <div><p>{halloween ? hw.date : t.eventDate}</p><strong>{new Intl.DateTimeFormat(localeConfig[locale].languageTag, { day: 'numeric', month: 'long', year: 'numeric',timeZone:event.datesByMarket[market].timezone }).format(new Date(event.datesByMarket[market].eventAt))}</strong><p>{halloween ? hw.context : t.eventContext}</p></div>
    </div>
  </section>
  <section class="section" id="event-picks"><div class="container"><div class="section-head"><div><SectionLabel text={bt.label}/><EditorialHeading>{bt.title}</EditorialHeading></div><p class="section-intro">{bt.eventIntro}</p></div><BrandPicks {locale} eventId={event.id} placement="event-brand"/><nav class="chip-row" aria-label={t.upcoming}>{events.filter(other=>other.id!==event.id).map(other=><a class="text-link" href={localPath(locale,`events/${other.slug[locale]}/`)}>{other.name[locale]} →</a>)}</nav></div></section>
  <section class="section-compact"><div class="container"><h2 class="editorial-heading">{halloween ? hw.delivery : t.deliveryTitle}</h2><p class="section-intro">{halloween ? hw.deliveryCopy : t.deliveryCopy}</p></div></section>
  <FAQ {locale}/>
</SiteLayout>
<style>
  .event-detail { background: var(--accent-soft); }
  .event-detail__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: end; }
  .event-detail__grid > div:last-child { padding-left: 30px; border-left: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); }
  .event-detail__grid p { color: var(--muted-text); font-size: .8rem; }
  .event-detail__grid strong { font-family: var(--display); font-size: 1.7rem; font-weight: 500; }
  @media(max-width:700px){.event-detail__grid{grid-template-columns:1fr}.event-detail__grid>div:last-child{padding:20px 0 0;border-left:0;border-top:var(--border)}}
</style>
