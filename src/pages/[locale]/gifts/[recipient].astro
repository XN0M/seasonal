---
import SiteLayout from '@/layouts/SiteLayout.astro'
import BrandCard from '@/components/commerce/BrandCard.astro'
import {activeEvent} from '@/data/catalog'
import {brandRegistry} from '@/data/brands'
import {brandCards} from '@/lib/brands'
import {brandCopy} from '@/lib/brand-copy'
import {localeCodes,type Locale,type Recipient} from '@/lib/types'
import {localPath,localeConfig,ui} from '@/lib/i18n'
export const getStaticPaths=()=>localeCodes.flatMap(locale=>(['women','family','children','teens'] as const).map(recipient=>({params:{locale,recipient},props:{locale,recipient}})))
const {locale,recipient}=Astro.props as {locale:Locale;recipient:Recipient}
const t=ui[locale],market=localeConfig[locale].market
const names={'en-gb':{women:'Gifts for women',family:'Family gifts',children:'Gifts for children',teens:'Gifts for teens'},'de-de':{women:'Geschenke für sie',family:'Familiengeschenke',children:'Geschenke für Kinder',teens:'Geschenke für Teenager'},'fr-fr':{women:'Cadeaux pour elle',family:'Cadeaux famille',children:'Cadeaux pour enfants',teens:'Cadeaux pour adolescents'}}
const selected=brandCards(brandRegistry,market,activeEvent.id,locale,{recipient,availableOnly:true})
const bt=brandCopy[locale]
---
<SiteLayout title={`${names[locale][recipient]} | Seasonal Edit`} description={t.finderCopy} {locale} event={activeEvent} pathname={`gifts/${recipient}/`}><section class="container section"><p class="section-label">{t.gifts}</p><h1 class="editorial-heading">{names[locale][recipient]}</h1><p class="section-intro">{t.finderCopy}</p><a class="button button--secondary" href={`${localPath(locale,'gift-finder/')}?recipient=${recipient}`}>{t.findGift} →</a><p class="grid-disclosure">{bt.disclosure}</p><h2 class="sr-only">{t.brands}</h2><div class="brand-grid">{selected.map(card=><BrandCard {card} {locale} {market} eventId={activeEvent.id} placement={`gifts-${recipient}`}/>)}</div></section></SiteLayout>
