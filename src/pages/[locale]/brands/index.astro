---
import SiteLayout from '@/layouts/SiteLayout.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import { activeEvent } from '@/data/catalog'
import { isLocale, ui } from '@/lib/i18n'
import { localeCodes, type Locale } from '@/lib/types'
export const getStaticPaths = () => localeCodes.map(locale => ({ params: { locale } }))
const param = Astro.params.locale
if (!isLocale(param)) return Astro.redirect('/')
const locale: Locale = param
const t = ui[locale]
---
<SiteLayout title={`${t.brands} | Seasonal Edit`} description="Verified brand directory preview." {locale} event={activeEvent} pathname="brands/">
  <section class="brands-page section"><div class="container"><SectionLabel text={t.brands}/><h1>A directory built on<br/><em>verified partnerships.</em></h1><p>The public directory will only include brands with authorised imagery, market-relevant products and valid merchant offers.</p><div class="empty"><span>Directory preview</span><h2>No commercial brands are published yet.</h2><p>This is intentional: the project will not simulate partnerships, logos, prices or outbound links.</p></div></div></section>
</SiteLayout>
<style>
  h1{margin:0;max-width:14ch;font-family:var(--display);font-size:clamp(3.2rem,7vw,6.5rem);line-height:.9;letter-spacing:-.05em;font-weight:500}h1 em{font-weight:400;color:var(--accent)}.brands-page>.container>p{max-width:60ch;color:var(--muted-text)}.empty{margin-top:50px;padding:clamp(30px,6vw,80px);border:1px dashed var(--moss);background:var(--paper-raised);text-align:center}.empty span{color:var(--accent);font-size:.7rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.empty h2{font-family:var(--display);font-size:clamp(2rem,4vw,3.5rem);font-weight:500}.empty p{color:var(--muted-text)}
</style>
