---
import '@/styles/global.css'
import Button from '@/components/ui/Button.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import EditorialHeading from '@/components/ui/EditorialHeading.astro'
import Stack from '@/components/ui/Stack.astro'
import Cluster from '@/components/ui/Cluster.astro'
import Tag from '@/components/ui/Tag.astro'
import ProductCard from '@/components/commerce/ProductCard.astro'
import {products} from '@/data/catalog'
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Design system preview | Seasonal Edit</title></head><body><main class="container section"><h1 class="editorial-heading">The seasonal system.</h1><section class="fixture-commerce"><h2>Disabled commerce fixture</h2><ProductCard product={products[0]!} locale="en-gb" market="GB" eventId="fixture" pendingLabel="Preview only" bestForLabel="Best for" previewLabel="Preview fixture"/></section>{['christmas','black-friday','halloween','winter'].map(theme=><section class="theme-panel" data-theme={theme}><Stack><SectionLabel text={theme}/><EditorialHeading>Considered gifts.<br/><em>Clear choices.</em></EditorialHeading><Cluster><Button href="/en-gb/" label="Explore the edit"/><Button href="/en-gb/gift-finder/" label="Find a gift" variant="secondary"/><Button label="Unavailable" variant="disabled"/><Tag label="Editorial preview"/></Cluster><p class="muted">Paper, ink, semantic accents. Focus and hover remain consistent across seasons.</p></Stack></section>)}</main></body></html>
<style>.theme-panel{padding:40px;margin-block:24px;border:var(--border);background:var(--accent-soft);border-radius:var(--radius-panel)}.theme-panel .muted{font-size:1rem}</style>
