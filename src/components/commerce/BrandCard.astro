---
import type {BrandCardModel} from '@/lib/brands'
import type {Locale,Market} from '@/lib/types'
import {localPath} from '@/lib/i18n'
import {brandCopy,brandCategoryLabels} from '@/lib/brand-copy'
import BrandAffiliateLink from './BrandAffiliateLink.astro'
import BrandMediaFrame from '@/components/ui/BrandMediaFrame.astro'
import FulfilmentNotice from './FulfilmentNotice.astro'
interface Props {card:BrandCardModel;locale:Locale;market:Market;eventId:string;placement:string;presentation?:'compact'|'editorial'}
const {card,locale,market,eventId,placement,presentation='compact'}=Astro.props
const {profile,link,products}=card
const t=brandCopy[locale]
const lead=presentation==='editorial'?products[0]:undefined
const thumbnails=products.slice(lead?1:0,3)
---
<article class:list={['brand-card',{'brand-card--available':Boolean(link),'brand-card--editorial':presentation==='editorial'}]} data-brand-id={profile.id}>
  {lead && <div class="brand-card__lead" data-brand-lead={lead.id}>{link?<BrandAffiliateLink {link} {locale} {market} {eventId} placement={`${placement}-lead-image`} featuredProductId={lead.id} label={`${t.at} ${profile.name}: ${lead.name[locale]}`}><BrandMediaFrame image={lead.image} alt={lead.imageAlt[locale]} sizes="(max-width: 620px) 44vw, (max-width: 1100px) 42vw, 24vw"/></BrandAffiliateLink>:<BrandMediaFrame image={lead.image} alt={lead.imageAlt[locale]}/>}</div>}
  <div class="brand-card__body">
  <div class="brand-card__identity"><p class="section-label">{brandCategoryLabels[locale][profile.category]}</p><h3>{profile.name}</h3><p class="brand-card__summary">{profile.summary[locale]}</p></div>
  {thumbnails.length>0 && <div class="brand-card__thumbnails">{thumbnails.map(product=><div class="brand-card__thumb">{link?<BrandAffiliateLink {link} {locale} {market} {eventId} placement={`${placement}-thumbnail`} featuredProductId={product.id} label={`${t.at} ${profile.name}: ${product.name[locale]}`}><BrandMediaFrame image={product.image} alt={product.imageAlt[locale]} sizes="(max-width: 720px) 27vw, 12vw"/></BrandAffiliateLink>:<BrandMediaFrame image={product.image} alt={product.imageAlt[locale]} sizes="(max-width: 720px) 27vw, 12vw"/>}</div>)}</div>}
  <FulfilmentNotice notice={card.fulfilment} {locale} id={`availability-${placement}-${profile.id}`}/>
  {!link && <p class="brand-card__status">{t.unavailable}</p>}
  <div class="brand-card__actions">
    {link?<BrandAffiliateLink {link} {locale} {market} {eventId} {placement} class="button button--primary" label={`${t.visit}: ${profile.name}`}>{t.visit}<span aria-hidden="true">↗</span></BrandAffiliateLink>:<button type="button" class="button button--disabled" disabled aria-describedby={`availability-${placement}-${profile.id}`}>{t.visit}</button>}
    <a class="button button--secondary" href={localPath(locale,`brands/${profile.slug}/`)} aria-label={`${t.explore}: ${profile.name}`}>{t.explore}<span aria-hidden="true">→</span></a>
  </div>
  </div>
</article>
<style>
  .brand-card{min-width:0;display:flex;flex-direction:column;border:var(--border);border-radius:var(--radius-editorial,24px);background:var(--paper-raised);transition:transform var(--motion-card) var(--ease-out),box-shadow var(--motion-card) ease}
  .brand-card__body{display:flex;flex-direction:column;flex:1;padding:clamp(22px,3vw,32px);min-width:0}
  .brand-card__lead{aspect-ratio:4/5;padding:16px;background:var(--paper);border-radius:var(--radius-editorial) var(--radius-editorial) 0 0}
  .brand-card__lead :global(a){display:block;width:100%;height:100%;border-radius:12px}
  .brand-card--editorial h3{font-size:clamp(1.5rem,2.6vw,2.2rem)}
  .brand-card--editorial .brand-card__body{padding:clamp(16px,2vw,24px)}
  .brand-card--available:focus-within{box-shadow:var(--shadow)}
  @media(hover:hover) and (pointer:fine){.brand-card--available:hover{transform:translateY(-2px);box-shadow:var(--shadow)}}
  h3{margin:0;font-family:var(--display);font-weight:500;font-size:clamp(1.8rem,2.8vw,2.5rem);line-height:1.12;overflow-wrap:anywhere}
  .section-label{font-size:.72rem}
  .brand-card__summary{margin:16px 0 22px;color:var(--muted-text);font-size:.95rem;line-height:1.6}
  .brand-card__status{margin:auto 0 18px;padding-top:16px;border-top:var(--border);font-size:.875rem;color:var(--muted-text)}
  .brand-card__actions{display:flex;flex-direction:column;gap:10px}
  .brand-card__actions :global(.button){width:100%;letter-spacing:.06em;text-align:center}
  .brand-card__thumbnails{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:20px}
  .brand-card__thumb{aspect-ratio:1;background:var(--paper);border-radius:12px}
  .brand-card__thumb :global(a){display:block;width:100%;height:100%;border-radius:12px}
</style>
