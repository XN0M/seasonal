---
import type { Locale, SeasonalEvent } from '@/lib/types'
import Button from '@/components/ui/Button.astro'
import MediaFrame from '@/components/ui/MediaFrame.astro'
import { localPath } from '@/lib/i18n'
interface Props { event: SeasonalEvent; locale: Locale; primary: string; secondary: string; secondaryHref?: string }
const { event, locale, primary, secondary, secondaryHref } = Astro.props
---
<section class="event-hero" aria-labelledby="hero-title">
  <div class="container event-hero__grid">
    <div class="event-hero__copy">
      <p class="section-label">{event.eyebrow[locale]}</p>
      <h1 id="hero-title">{event.headline[locale]}</h1>
      <p>{event.description[locale]}</p>
      <div class="event-hero__actions">
        <Button href={`${localPath(locale, 'gift-finder/')}?event=${event.id}`} label={primary} />
        <Button href={secondaryHref ?? localPath(locale, `events/${event.slug[locale]}/`)} label={secondary} variant="secondary" />
      </div>
      <div class="event-hero__note"><span>01</span><p>Independent picks organised around real recipients, budgets and market availability.</p></div>
    </div>
    <div class="event-hero__visual">
      <div class="event-hero__arch"><MediaFrame src={event.image} alt="Unbranded seasonal gift selection in a warm editorial studio" eager /></div>
      <span class="event-hero__seal" aria-hidden="true">Seasonal<br/>Edit</span>
    </div>
  </div>
</section>
<style>
  .event-hero { min-height: min(640px, calc(100vh - 110px)); display: grid; align-items: center; overflow: hidden; border-bottom: var(--border); }
  .event-hero__grid { display: grid; grid-template-columns: 5fr 7fr; align-items: center; gap: clamp(34px, 6vw, 90px); padding-block: 46px; }
  h1 { max-width: 10ch; margin: 0; font-family: var(--display); font-size: clamp(3.1rem, 7vw, 6.4rem); font-weight: 500; line-height: .86; letter-spacing: -.055em; }
  .event-hero__copy > p:not(.section-label) { max-width: 48ch; color: var(--muted-text); font-size: 1rem; }
  .event-hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 25px; }
  .event-hero__note { display: flex; gap: 15px; align-items: start; max-width: 400px; margin-top: 34px; padding-top: 18px; border-top: var(--border); }
  .event-hero__note span { font-family: var(--display); color: var(--accent); font-style: italic; }
  .event-hero__note p { margin: 0; font-size: .76rem; color: var(--muted-text); }
  .event-hero__visual { position: relative; padding: 0 24px 18px 0; }
  .event-hero__arch { height: min(540px, 66vh); overflow: hidden; border-radius: 260px 260px 8px 8px; background: var(--stone); }
  .event-hero__arch :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .event-hero__seal { position: absolute; right: 0; bottom: 0; width: 92px; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: white; text-align: center; font-family: var(--display); font-style: italic; line-height: 1.1; transform: rotate(7deg); }
  @media (max-width: 780px) {
    .event-hero { min-height: auto; }
    .event-hero__grid { grid-template-columns: 1fr 1fr; gap: 20px; padding-block: 30px; }
    .event-hero__copy { grid-column: 1/-1; }
    .event-hero__visual { grid-column:1/-1;padding:0; }
    .event-hero__arch { height:160px;border-radius:80px 80px 4px 4px; }
    .event-hero__seal { width:60px;font-size:.8rem; }
    h1 { max-width:16ch;font-size: clamp(2.8rem, 12vw, 4.8rem);line-height:.96; }
    .event-hero__note { display: none; }
    .event-hero__actions :global(.button) { flex: 1; }
  }
</style>
