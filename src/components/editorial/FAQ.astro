---
import type { Locale } from '@/lib/types'
import {serialiseJsonLd} from '@/lib/seo/json'
interface Props { locale:Locale }
const {locale} = Astro.props
const copy = {
  'en-gb': {title:'A few useful answers.',items:[['When should I start shopping?','Plan early around the person and budget. Check the retailer’s delivery estimate and return window before buying. Event phases are planning guidance, not delivery guarantees.'],['Where do I complete my purchase?','Purchases happen on the retailer’s website. They handle payments, shipping and returns. This preview contains no active commercial links.'],['How are gifts for children selected?','The content is for adults choosing gifts. Age suitability must be confirmed using manufacturer guidance, and small parts and safety warnings must be checked before purchase.'],['Are recommendations medical advice?','No. Beauty and self-care content is general information. For a health concern or product reaction, seek advice from a qualified professional.']]},
  'de-de': {title:'Einige hilfreiche Antworten.',items:[['Wann sollte ich einkaufen?','Planen Sie nach Person und Budget. Prüfen Sie Lieferzeit und Rückgabefrist beim Händler. Die Phasen garantieren keine Lieferung.'],['Wo schließe ich den Kauf ab?','Beim Händler, der Zahlung, Versand und Rückgabe übernimmt. Diese Vorschau enthält keine aktiven kommerziellen Links.'],['Wie werden Kindergeschenke ausgewählt?','Die Inhalte richten sich an Erwachsene. Prüfen Sie Altersempfehlung, Kleinteile und Sicherheitshinweise des Herstellers.'],['Sind die Empfehlungen medizinische Beratung?','Nein. Beauty- und Self-Care-Inhalte sind allgemeine Informationen. Bei gesundheitlichen Fragen wenden Sie sich an qualifiziertes Fachpersonal.']]},
  'fr-fr': {title:'Quelques réponses utiles.',items:[['Quand commencer mes achats ?','Planifiez selon la personne et votre budget. Vérifiez les délais de livraison et de retour du marchand. Les phases ne garantissent pas la livraison.'],["Où finaliser mon achat ?",'Sur le site du marchand, qui gère le paiement, la livraison et les retours. Cet aperçu ne contient aucun lien commercial actif.'],['Comment choisir pour les enfants ?',"Ces contenus s’adressent aux adultes. Vérifiez l’âge recommandé, les petites pièces et les consignes de sécurité du fabricant."],['Est-ce un conseil médical ?',"Non. Ces contenus sont généraux. Pour une question de santé, consultez un professionnel qualifié."]]},
}
const t = copy[locale]
---
<section class="section-compact"><div class="container faq"><h2>{t.title}</h2><div>{t.items.map(item => <details><summary>{item[0]}</summary><p>{item[1]}</p></details>)}</div></div></section>
<script type="application/ld+json" set:html={serialiseJsonLd({'@context':'https://schema.org','@type':'FAQPage',mainEntity:t.items.map(([question,answer])=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))})}/>
<style>.faq{display:grid;grid-template-columns:1fr 1.5fr;gap:60px}.faq h2{font-family:var(--display);font-size:clamp(2.3rem,4vw,4rem);font-weight:500;line-height:1}.faq details{border-bottom:var(--border)}.faq summary{min-height:58px;cursor:pointer;padding:17px 6px;font-weight:600;font-size:.9rem}.faq p{max-width:65ch;font-size:.85rem;color:var(--muted-text);padding-inline:6px}@media(max-width:720px){.faq{grid-template-columns:1fr;gap:20px}}</style>
