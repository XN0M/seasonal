---
interface Props { href?: string; variant?: 'primary' | 'secondary' | 'disabled'; label: string }
const { href, variant = 'primary', label } = Astro.props
const classes = ['button', `button--${variant}`]
---
{href && variant !== 'disabled' ? <a class:list={classes} href={href}>{label}<span aria-hidden="true">↗</span></a> : <button class:list={classes} type="button" disabled={variant === 'disabled'}>{label}</button>}
