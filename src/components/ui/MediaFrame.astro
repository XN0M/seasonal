---
interface Props { src: string; mobileSrc?: string | undefined; tabletSrc?: string | undefined; alt: string; sizes?: string; eager?: boolean; fit?: 'cover' | 'contain' }
const { src, mobileSrc, tabletSrc, alt, sizes = '(max-width: 720px) 100vw, 50vw', eager = false, fit = 'cover' } = Astro.props
const base = src.replace(/\.webp$/, '')
const widths = [320, 640, 960, 1400]
const srcset = (ext: string) => widths.map(width => `${base}-${width}.${ext} ${width}w`).join(', ')
---
<picture class:list={['media-frame', `media-frame--${fit}`]}>
  {tabletSrc && <source media="(min-width: 501px) and (max-width: 780px)" type="image/svg+xml" srcset={tabletSrc} />}
  {mobileSrc && <source media="(max-width: 780px)" type="image/svg+xml" srcset={mobileSrc} />}
  {!src.endsWith('.svg') && <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />}
  <img src={src} srcset={src.endsWith('.svg') ? undefined : srcset('webp')} sizes={sizes} {alt} width="1400" height="1400" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'low'} decoding="async" />
</picture>
<style>.media-frame{display:block;width:100%;height:100%}.media-frame img{width:100%;height:100%}.media-frame--cover img{object-fit:var(--hero-media-fit,cover)}.media-frame--contain img{object-fit:contain}</style>
