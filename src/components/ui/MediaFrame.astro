---
interface Props { src: string; alt: string; sizes?: string; eager?: boolean; fit?: 'cover' | 'contain' }
const { src, alt, sizes = '(max-width: 720px) 100vw, 50vw', eager = false, fit = 'cover' } = Astro.props
const base = src.replace(/\.webp$/, '')
const widths = [320, 640, 960, 1400]
const srcset = (ext: string) => widths.map(width => `${base}-${width}.${ext} ${width}w`).join(', ')
---
<picture class:list={['media-frame', `media-frame--${fit}`]}>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <img src={src} srcset={srcset('webp')} sizes={sizes} {alt} width="1400" height="1400" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
</picture>
<style>.media-frame{display:block;width:100%;height:100%}.media-frame img{width:100%;height:100%}.media-frame--cover img{object-fit:cover}.media-frame--contain img{object-fit:contain}</style>
